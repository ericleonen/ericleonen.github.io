---
// A hand-made "emoji": 折紙 (origami) set as vector outlines rather than text, so
// it renders identically for everyone — no CJK font needed on the visitor's
// machine. Outlines traced from IPAGothic (IPA Font License), then normalised
// into this viewBox. Sized in `em` so it sits on a text baseline like a real
// emoji does, and it wiggles on hover just like <Emoji>.
interface Props {
  class?: string;
  title?: string;
}

const { class: className, title = 'origami (折紙)' } = Astro.props;
---

