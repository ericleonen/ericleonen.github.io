---
// A hand-made "emoji" for origami: 折紙, set as vector outlines rather than text
// so it renders identically for everyone — no CJK font needed on the visitor's
// machine. Outlines traced from IPAGothic (IPA Font License) and normalised into
// this viewBox.
//
// IPAGothic ships no bold weight, so the weight comes from stroking each path in
// its own fill colour, which fattens every stroke symmetrically. The viewBox
// carries a margin so those strokes aren't clipped at the edges.
//
// Sized in `em` so it scales with the surrounding text and sits on the baseline
// like a real emoji, and it wiggles on hover just like <Emoji>.
interface Props {
  class?: string;
  title?: string;
}

const { class: className, title = 'origami (折紙)' } = Astro.props;
---

<svg
  viewBox="0 0 221.8 114"
  role="img"
  aria-label={title}
  fill="currentColor"
  stroke="currentColor"
  stroke-width="3.5"
  stroke-linejoin="round"
  class:list={['inline-block w-auto h-[1.2em] align-[-0.21em] hover:animate-wiggle', className]}
>
  <title>{title}</title>
  <!-- 折 -->
