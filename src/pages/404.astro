---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import Link from '../components/Link.astro';
import Emoji from '../components/Emoji.astro';
---

<Layout title="404 — Eric Leonen" description="This page doesn't exist.">
  <div class="text-center py-10">
    <p class="text-8xl leading-none select-none">
      <span role="img" aria-label="Shrug"><Emoji>🤷🏽‍♂️</Emoji></span>
    </p>

    <h1 class="text-2xl font-bold mt-8"><Highlight preserveCase>404</Highlight></h1>

    <p class="text-gray-800 leading-relaxed mt-4">
      This page got folded into something else.
    </p>

    <p class="text-sm mt-6">
      <Link href="/">back home</Link>
    </p>
  </div>
</Layout>
