---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import Link from '../components/Link.astro';
import OrigamiIcon from '../components/OrigamiIcon.astro';
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const IMAGE_EXTS = ['.webp', '.jpg', '.jpeg', '.png', '.gif'];

// A model's photo is found by filename: src/content/origami/crane.md pairs with
// public/origami/crane.<ext>. Frontmatter `image` overrides that if you'd rather
// name them differently.
function resolveImage(id: string, image?: string): string | null {
  const dir = path.join(process.cwd(), 'public', 'origami');
  if (image) return image.startsWith('/') ? image : `/origami/${image}`;
  for (const ext of IMAGE_EXTS) {
    if (fs.existsSync(path.join(dir, `${id}${ext}`))) return `/origami/${id}${ext}`;
  }
  return null;
}

// Newest first; undated models keep to the back rather than jumping the queue.
const byDate = (a: { data: { date?: Date } }, b: { data: { date?: Date } }) =>
  (b.data.date?.valueOf() ?? -Infinity) - (a.data.date?.valueOf() ?? -Infinity);

const models = await Promise.all(
  (await getCollection('origami')).sort(byDate).map(async model => ({
    ...model,
    src: resolveImage(model.id, model.data.image),
    formattedDate: model.data.date?.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }),
    Content: (await render(model)).Content,
  }))
);
---

<Layout title="Origami — Eric Leonen" description="Origami models folded by Eric Leonen.">
  <h1 class="text-2xl font-bold mb-3"><Highlight preserveCase>Origami</Highlight></h1>
  <p class="text-gray-800 leading-relaxed mb-10">
    Paper I've folded, newest first. One square, no cuts, no glue &mdash; usually.
  </p>

  {models.length > 0
    ? (
      <div class="divide-y divide-gray-200">
        {models.map(model => (
          <figure class="py-10 first:pt-0 last:pb-0">
            {model.src && (
              <button
                type="button"
                data-lightbox-src={model.src}
                data-lightbox-alt={model.data.title}
                class="block w-full mb-5 cursor-zoom-in"
                aria-label={`View ${model.data.title} larger`}
              >
                <img
                  src={model.src}
                  alt={model.data.title}
                  loading="lazy"
                  decoding="async"
                  class="block mx-auto w-auto max-w-full max-h-[32rem] rounded border border-gray-200 transition-transform duration-200 hover:-translate-y-1"
                />
              </button>
            )}

            <figcaption>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h2 class="font-medium">{model.data.title}</h2>
                {model.formattedDate && (
                  <span class="text-xs text-gray-400">{model.formattedDate}</span>
                )}
              </div>

              <!-- Credit where it's due: the designer, and what it was folded from. -->
              {(model.data.designer || model.data.paper) && (
                <dl class="flex flex-wrap gap-x-6 gap-y-1 mt-3 text-sm">
                  {model.data.designer && (
                    <div class="flex gap-2">
                      <dt class="text-gray-400 shrink-0">designed by</dt>
                      <dd class="text-gray-700">
                        {model.data.designerUrl
                          ? <Link href={model.data.designerUrl} external>{model.data.designer}</Link>
                          : model.data.designer
                        }
                      </dd>
                    </div>
                  )}
                  {model.data.paper && (
                    <div class="flex gap-2">
                      <dt class="text-gray-400 shrink-0">folded from</dt>
                      <dd class="text-gray-700">{model.data.paper}</dd>
                    </div>
                  )}
                </dl>
              )}

              <div class="text-sm text-gray-700 mt-3 prose prose-sm prose-gray max-w-none">
                <model.Content />
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    )
    : (
      <div class="text-center py-10">
        <OrigamiIcon class="!h-16 opacity-30" />
        <p class="text-sm text-gray-400 mt-5">No models here yet. Paper's in the mail.</p>
      </div>
    )
  }

  <!-- Lightbox -->
  <dialog
    id="origami-lightbox"
    class="m-auto max-w-[92vw] max-h-[92vh] bg-transparent backdrop:bg-black/70 p-0"
  >
    <!-- No src until a model is picked: an empty src="" makes some browsers re-request the page. -->
    <img id="origami-lightbox-img" alt="" class="max-w-[92vw] max-h-[92vh] w-auto h-auto rounded" />
  </dialog>

  <script>
    // astro:page-load fires on first load and after every client-side navigation
    document.addEventListener('astro:page-load', () => {
      const dialog = document.getElementById('origami-lightbox') as HTMLDialogElement | null;
      const img = document.getElementById('origami-lightbox-img') as HTMLImageElement | null;
      if (!dialog || !img) return;

      document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach(btn => {
        btn.addEventListener('click', () => {
          img.src = btn.dataset.lightboxSrc ?? '';
          img.alt = btn.dataset.lightboxAlt ?? '';
          dialog.showModal();
        });
      });

      // Click anywhere (image included) to dismiss; Escape works for free.
      dialog.addEventListener('click', () => dialog.close());
    });
  </script>
</Layout>
